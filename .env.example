# ==============================================================================
# SpecForge — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------------------
# Flask / App
# ------------------------------------------------------------------------------
SECRET_KEY=               # REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(64))"
PORT=5000
FLASK_DEBUG=false          # Set to "true" for local development only
LOG_LEVEL=INFO

# Session security
SESSION_COOKIE_SECURE=true          # Must be true in production (requires HTTPS)
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12
TOKEN_ENCRYPTION_SECRET=            # REQUIRED in production. Generate like SECRET_KEY.

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# For local development, omit this to use SQLite (specforge.db)
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/specforge

# ------------------------------------------------------------------------------
# AI Providers — MiniMax
# ------------------------------------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Optional: MiniMax OAuth (for user-linked tokens)
MINIMAX_CLIENT_ID=
MINIMAX_CLIENT_SECRET=
MINIMAX_REDIRECT_URI=http://localhost:5000/auth/minimax/callback

# ------------------------------------------------------------------------------
# AI Providers — OpenRouter
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=       # Get from https://openrouter.ai/keys
OPENROUTER_MODEL=openai/gpt-4o-mini    # Any model from https://openrouter.ai/models
OPENROUTER_SITE_URL=https://specforge.dev   # Your domain (sent as HTTP-Referer)

# ------------------------------------------------------------------------------
# Quota / Billing
# ------------------------------------------------------------------------------
# strict = enforce limits (production)
# soft   = warn but don't block
# off    = no limits (testing only — NEVER use in production)
QUOTA_ENFORCEMENT=strict

# PayPal billing (optional — for paid plans)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_ENTERPRISE=
PAYPAL_PLAN_PRICE_PRO=$19.99/month
PAYPAL_PLAN_PRICE_ENTERPRISE=$99.99/month

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
AI_ENHANCEMENT_ENABLED=true
MINIMAX_OAUTH_ENABLED=false
EXPORT_SHARING_ENABLED=true
ANALYTICS_ENABLED=true

# ------------------------------------------------------------------------------
# Rate Limits (requests per 60-second window)
# ------------------------------------------------------------------------------
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_MINIMAX_CHAT=10
RATE_LIMIT_MINIMAX_ENHANCE=10
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_CALLBACK=20
RATE_LIMIT_LIST_ANALYSES=60
RATE_LIMIT_GET_ANALYSIS=120
RATE_LIMIT_GET_JOB=120
RATE_LIMIT_AUTH_STATUS=60

# ------------------------------------------------------------------------------
# Health Check Thresholds
# ------------------------------------------------------------------------------
HEALTH_QUEUE_BACKLOG_WARNING=100
HEALTH_QUEUE_BACKLOG_CRITICAL=500
HEALTH_FAILED_JOBS_CRITICAL=25

# ------------------------------------------------------------------------------
# Content Limits
# ------------------------------------------------------------------------------
MAX_CONTENT_LENGTH_BYTES=65536

# App version (set automatically in CI/CD)
APP_VERSION=2.1.0
