APP_VERSION=2.1.0
PORT=5000
DATABASE_URL=postgresql+psycopg://specforge:specforge@postgres:5432/specforge
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_SECRET=replace-with-a-second-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12

# MiniMax AI
MINIMAX_CLIENT_ID=
MINIMAX_CLIENT_SECRET=
MINIMAX_REDIRECT_URI=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# PayPal Billing
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_ENTERPRISE=
PAYPAL_PLAN_PRICE_PRO=$19.99/month
PAYPAL_PLAN_PRICE_ENTERPRISE=$99.99/month

# Feature Flags
AI_ENHANCEMENT_ENABLED=true
MINIMAX_OAUTH_ENABLED=false
EXPORT_SHARING_ENABLED=true
ANALYTICS_ENABLED=true
QUOTA_ENFORCEMENT=strict

# Rate Limits
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_MINIMAX_CHAT=10
RATE_LIMIT_MINIMAX_ENHANCE=10
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_CALLBACK=20
RATE_LIMIT_LIST_ANALYSES=60
RATE_LIMIT_GET_ANALYSIS=120
RATE_LIMIT_GET_JOB=120
RATE_LIMIT_AUTH_STATUS=60

# Health Check Thresholds
HEALTH_QUEUE_BACKLOG_WARNING=100
HEALTH_QUEUE_BACKLOG_CRITICAL=500
HEALTH_FAILED_JOBS_CRITICAL=25

# Content Size
MAX_CONTENT_LENGTH_BYTES=65536

# Logging
LOG_LEVEL=INFO
