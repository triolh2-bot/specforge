# Flask Configuration
SECRET_KEY=your-secret-key-here
PORT=5000
DEBUG=False
DATABASE_URL=sqlite:///specforge.db

# MiniMax OAuth (get from https://platform.minimaxi.com)
MINIMAX_CLIENT_ID=your-client-id
MINIMAX_CLIENT_SECRET=your-client-secret
MINIMAX_REDIRECT_URI=https://your-domain.com/auth/minimax/callback

# OR use API key directly (no OAuth needed)
MINIMAX_API_KEY=your-api-key
MINIMAX_GROUP_ID=your-group-id
